# Git profile — account A (generated by switchcraft, do not edit by hand)
[user]
    name = {{A_NAME}}
    email = {{A_EMAIL}}
    signingkey = {{HOME}}/.ssh/id_ed25519_{{A_SLUG}}.pub
[core]
    sshCommand = ssh -i {{HOME}}/.ssh/id_ed25519_{{A_SLUG}} -o IdentitiesOnly=yes
[credential]
    helper = 
    helper = store --file={{PROJECTS_ROOT}}/{{A_SLUG}}/.git-credentials
