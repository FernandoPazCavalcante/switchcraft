# Git profile — account B (generated by switchcraft, do not edit by hand)
[user]
    name = {{B_NAME}}
    email = {{B_EMAIL}}
    signingkey = {{HOME}}/.ssh/id_ed25519_{{B_SLUG}}.pub
[core]
    sshCommand = ssh -i {{HOME}}/.ssh/id_ed25519_{{B_SLUG}} -o IdentitiesOnly=yes
[credential]
    # clean global helpers and use the file from this account. (remotes HTTPS)
    helper =
    helper = store --file={{PROJECTS_ROOT}}/{{B_SLUG}}/.git-credentials
