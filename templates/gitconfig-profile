# Git profile — account {{SLUG}} (generated by switchcraft, do not edit by hand)
[user]
    name = {{NAME}}
    email = {{EMAIL}}
    signingkey = {{HOME}}/.ssh/id_ed25519_{{SLUG}}.pub
[core]
    sshCommand = ssh -i {{HOME}}/.ssh/id_ed25519_{{SLUG}} -o IdentitiesOnly=yes
[credential]
    # clean global helpers and use the file from this account. (remotes HTTPS)
    helper =
    helper = store --file={{PROJECTS_ROOT}}/{{SLUG}}/.git-credentials
