# ============================================================
# .env.example — copy to .env and fill in your data.
# .env is gitignored: personal data and tokens live only there.
#   cp .env.example .env
# ============================================================

PROJECTS_ROOT="$HOME/projects"

# ---------------- Account A ----------------
A_SLUG="personal"
A_GIT_NAME="Your Name"
A_GIT_EMAIL="you@example.com"
A_GITHUB_USER="your-github-user"
#A_GITHUB_TOKEN=""   # optional: PAT — auto-fills .git-credentials for HTTPS remotes

# ---------------- Account B ----------------
B_SLUG="work"
B_GIT_NAME="Your Name"
B_GIT_EMAIL="you@company.com"
B_GITHUB_USER="your-work-github-user"
#B_GITHUB_TOKEN=""
